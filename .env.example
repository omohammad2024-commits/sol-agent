# ---- Required ----
BOT_TOKEN=123456:ABC-from-BotFather

# anthropic | gemini | openai | opencode
# "openai" = any OpenAI-compatible API (OpenAI, DeepSeek, Groq, OpenRouter, Mistral,
# Together, xAI, Cloudflare Workers AI...). Set OPENAI_BASE_URL below.
# "opencode" = OpenCode Zen free gateway (https://opencode.ai/zen) — no key needed!
LLM_PROVIDER=opencode
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Optional model override (defaults: claude-sonnet-5-5 / gemini-2.5-flash / gpt-5-mini / mimo-v2.6-flash-free)
LLM_MODEL=
# Optional personal OpenCode Zen key (free models work without it; key lifts rate limits)
OPENCODE_API_KEY=
# --- OpenAI-compatible provider settings (only when LLM_PROVIDER=openai) ---
# Presets (copy one into OPENAI_BASE_URL):
#   OpenAI       https://api.openai.com/v1
#   DeepSeek     https://api.deepseek.com/v1
#   Groq         https://api.groq.com/openai/v1
#   OpenRouter   https://openrouter.ai/api/v1
#   Mistral      https://api.mistral.ai/v1
#   Together     https://api.together.xyz/v1
#   xAI (Grok)   https://api.x.ai/v1
#   OpenCode Zen https://opencode.ai/zen/v1          (free models: Kimi, GLM, MiniMax...)
#   Kimi Code    https://api.kimi.com/coding/v1
#   Kilo         https://api.kilo.ai/api/gateway
#   Cloudflare   https://api.cloudflare.com/client/v4/accounts/{ACCOUNT_ID}/ai/v1
# Custom provider: any other OpenAI-compatible endpoint works too — just put its
# base URL (/v1) in OPENAI_BASE_URL with its API key in OPENAI_API_KEY.
OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY is already defined below (used for STT/TTS too); reuse it here.

# ---- Creator / identity ----
# Your numeric Telegram id (ask the bot 'what is my id?' to see it). The bot recognises its creator ONLY by this id.
OWNER_ID=
# How the bot refers to you
OWNER_NAME=
# Names the bot answers to in groups (comma separated, whole-word match). BOT_NAME is always included.
BOT_NAMES=sol,سول
# After answering someone in a group, keep listening to them without the name for N seconds (0 = off)
GROUP_FOLLOWUP_SECONDS=60

# ---- Access control ----
# Comma-separated Telegram numeric user IDs
ADMIN_IDS=
TRUSTED_IDS=
# true: anyone can chat (public tools only). false: only admins/trusted.
PUBLIC_ACCESS=true
RATE_LIMIT_PER_MIN=12

# ---- General ----
BOT_NAME=SOL
TIMEZONE=Asia/Tehran
DATA_DIR=./data
MAX_TOOL_STEPS=8
HISTORY_LIMIT=20
TOOL_TIMEOUT_MS=120000

# ---- Code execution (admin only) ----
# docker: each run in a throwaway container (build ./sandbox first) | local: host process, stripped env | off
SANDBOX_MODE=docker
SANDBOX_IMAGE=sol-sandbox:latest
SANDBOX_NETWORK=false
EXEC_TIMEOUT_MS=30000

# ---- Webhook (leave empty for long polling) ----
# Public HTTPS base URL that reaches this server, e.g. https://bot.example.com  (reverse proxy -> PORT)
WEBHOOK_URL=
WEBHOOK_SECRET=
PORT=8080

# ---- Voice messages (speech-to-text): uses GEMINI_API_KEY, or OPENAI_API_KEY as fallback ----
OPENAI_API_KEY=
STT_PROVIDER=auto
STT_MODEL=

# ---- Safety caps ----
MAX_GIFTS_PER_DAY=3

# ---- Optional integrations (tool is disabled when the key is missing) ----
BRAVE_API_KEY=
GITHUB_TOKEN=
VIRUSTOTAL_API_KEY=
IMAGE_MODEL=gemini-2.5-flash-image
IRAN_RATES_URL=https://call2.tgju.org/ajax.json
YTDLP_COOKIES=
FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf

# =====================================================================================
# v2 additions
# =====================================================================================

# ---- Models: routing, fallback, cost ----
# Cheap model for simple turns (default: claude-haiku-5-5 / gemini-2.5-flash-lite). ROUTER=false -> always the strong model.
LLM_MODEL_FAST=
ROUTER=true
# If the primary provider fails, retry on this one (needs its API key). You get a Telegram notice when it happens.
FALLBACK_PROVIDER=
FALLBACK_MODEL=
# Estimated prices, USD per 1M tokens, to override/extend the built-in table:
# {"my-model":{"in":1,"out":5,"cacheRead":0.1,"cacheWrite":1.25}}
MODEL_PRICES=
# Max estimated spend per non-admin user per day (0 = unlimited)
DAILY_BUDGET_USD=0

# ---- Memory ----
# auto: Gemini/OpenAI embeddings if a key exists, otherwise an offline local embedder
EMBED_PROVIDER=auto
EMBED_MODEL=
# Summarize a chat into an "episode" after this many un-summarized messages
SUMMARY_TRIGGER=40

# ---- Replies ----
STREAMING=true
# Voice replies (text-to-speech). A spoken question gets a spoken answer when VOICE_REPLY=true.
TTS_PROVIDER=auto
TTS_MODEL=
TTS_VOICE=
VOICE_REPLY=true

# ---- Groups ----
# Save group messages (for "summarize the chat") in every group by default? Normally off; admins enable it per group.
GROUP_LOG_DEFAULT=false
# Let the AI judge messages against a group's natural-language rules
MOD_LLM=true

# ---- Scheduled / background work ----
BG_MAX_STEPS=20
ALERT_INTERVAL_MIN=5
MAX_JOBS_PER_USER=30

# ---- MCP servers (JSON file, default data/mcp.json; see mcp.example.json) ----
MCP_CONFIG=

# ---- Admin panel (Telegram Mini App). Needs a public HTTPS URL; in webhook mode WEBHOOK_URL is used. ----
PANEL_URL=

# ---- Operations ----
NOTIFY_OWNER=true
LOG_LEVEL=info
LOG_FILE=
BACKUP_ENABLED=true
BACKUP_HOUR=4
BACKUP_TO_OWNER=true
BACKUP_KEEP_DAYS=14
# REQUIRED to send backups to Telegram or S3 (they contain user data): backups are encrypted with AES-256-GCM
BACKUP_PASSPHRASE=
# Optional S3-compatible storage (AWS S3, Cloudflare R2, MinIO, ...)
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_REGION=auto
BACKUP_S3_PREFIX=sol-agent/
